{
	email {$ACME_EMAIL}
	acme_dns cloudflare {$CF_API_TOKEN}
}

# Pre-issue wildcard cert for *.{$HOME_DOMAIN}.
# Per-service blocks generated by caddy-docker-proxy reuse this cert
# from storage instead of issuing a new one per host.
*.{$HOME_DOMAIN} {
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}
	abort
}
